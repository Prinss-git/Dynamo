@model AttendanceSheetModel
@{
    ViewData["Title"] = "Report – " + Model.Event.Title;
    var ev = Model.Event;
}
<div class="page-header">
    <div>
        <h1>@ev.Title</h1>
        <p class="subtitle">@ev.OrganizationName · @ev.StartTime.ToString("MMMM d, yyyy h:mm tt") · @ev.Venue · @BadgeHelper.Badge(ev.Status)</p>
    </div>
    <div class="d-flex no-print" style="gap: 8px">
        <button type="button" class="btn btn-outline-primary" onclick="window.print()"><i class="fa-solid fa-print"></i> Print</button>
        <a class="btn btn-outline-secondary" asp-action="ExportEvent" asp-route-id="@ev.Id"><i class="fa-solid fa-file-csv"></i> Export CSV</a>
    </div>
</div>

<div class="stat-grid">
    <div class="stat-card"><div class="stat-icon"><i class="fa-solid fa-users"></i></div><div><div class="stat-value">@Model.Attendees.Count</div><div class="stat-label">Registered</div></div></div>
    <div class="stat-card"><div class="stat-icon"><i class="fa-solid fa-circle-check"></i></div><div><div class="stat-value">@Model.PresentCount</div><div class="stat-label">Present</div></div></div>
    <div class="stat-card"><div class="stat-icon"><i class="fa-solid fa-clock"></i></div><div><div class="stat-value">@Model.LateCount</div><div class="stat-label">Late</div></div></div>
    <div class="stat-card"><div class="stat-icon"><i class="fa-solid fa-user-xmark"></i></div><div><div class="stat-value">@Model.AbsentCount</div><div class="stat-label">Absent</div></div></div>
    <div class="stat-card"><div class="stat-icon"><i class="fa-solid fa-percent"></i></div><div><div class="stat-value">@Model.AttendanceRate%</div><div class="stat-label">Attendance rate</div></div></div>
</div>

<div class="panel">
    <h2>Attendance list</h2>
    @if (!Model.Attendees.Any())
    {
        <div class="empty-state"><i class="fa-solid fa-users"></i>No registered attendees.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-app">
                <thead>
                    <tr><th>#</th><th>Student</th><th>Course / Year</th><th>Registered</th><th>Status</th><th>Check-in</th><th>Check-out</th><th>Remarks</th></tr>
                </thead>
                <tbody>
                    @{ var i = 1; }
                    @foreach (var a in Model.Attendees)
                    {
                        <tr>
                            <td>@(i++)</td>
                            <td>@a.StudentName<div class="small text-muted">@a.StudentNumber</div></td>
                            <td>@a.Course@(a.YearLevel.HasValue ? " – " + a.YearLevel : "")</td>
                            <td class="small text-nowrap">@a.RegisteredTime.ToString("MMM d, h:mm tt")</td>
                            <td>@BadgeHelper.Badge(a.AttendanceStatus)</td>
                            <td class="small text-nowrap">@(a.CheckInTime?.ToString("h:mm tt") ?? "—")</td>
                            <td class="small text-nowrap">@(a.CheckOutTime?.ToString("h:mm tt") ?? "—")</td>
                            <td class="small">@a.Remarks</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (Model.Waitlist.Any())
{
    <div class="panel">
        <h2>Waitlist (@Model.Waitlist.Count)</h2>
        <ol class="mb-0">
            @foreach (var w in Model.Waitlist)
            {
                <li>@w.StudentName <span class="text-muted small">(@w.StudentNumber)</span></li>
            }
        </ol>
    </div>
}
