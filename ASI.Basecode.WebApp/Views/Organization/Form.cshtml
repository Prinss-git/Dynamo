@model OrganizationViewModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New Organization" : "Edit Organization";
}
<div class="page-header">
    <h1>@ViewData["Title"]</h1>
</div>

<div class="panel" style="max-width: 720px">
    <form asp-action="@(isNew ? "Create" : "Edit")" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

        <div class="form-row">
            <div class="form-group col-md-8">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="Acronym"></label>
                <input asp-for="Acronym" class="form-control" />
                <span asp-validation-for="Acronym" class="text-danger small"></span>
            </div>
        </div>
        <div class="form-group">
            <label asp-for="Adviser"></label>
            <input asp-for="Adviser" class="form-control" />
            <span asp-validation-for="Adviser" class="text-danger small"></span>
        </div>
        <div class="form-group">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>
        <div class="custom-control custom-checkbox mb-3">
            <input asp-for="IsActive" class="custom-control-input" />
            <label asp-for="IsActive" class="custom-control-label"></label>
        </div>

        <div class="d-flex" style="gap: 8px">
            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
