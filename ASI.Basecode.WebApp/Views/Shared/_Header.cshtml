@using System.Security.Claims
<header class="app-header @((ViewBag.LoginView == true) ? "hide-navbar" : "")">
    <div class="brand">
        <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle navigation">
            <i class="fa-solid fa-bars"></i>
        </button>
        <img src="~/img/asi-logo-invert.svg" class="hover-pointer"
             style="width: 150px;" alt="logo"
             onclick="window.location.href = '@Url.Action("Index", "Home")';">
        <span class="brand-title">Event Registration &amp; Attendance</span>
    </div>
    <div class="logosec">
        <div class="user-name">
            @User.Identity?.Name
            <span class="user-role">@User.FindFirst(ClaimTypes.Role)?.Value</span>
        </div>
        <div class="mr-20 hover-pointer" style="position: relative">
            <div class="dp">
                <img src="~/img/profile-logo.png"
                     class="dpicn hover-pointer"
                     alt="dp">
            </div>
            <div class="dropdown">
                <ul>
                    <li>
                        <i class="fa-solid fa-right-from-bracket"></i>
                        <a asp-action="SignOutUser" asp-controller="Account">Logout</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</header>
