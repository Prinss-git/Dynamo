@model UserModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New user" : "Edit user";
}
<a class="back" asp-action="Index"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Users</a>
<div class="page-head">
    <h1 class="page-title">@ViewData["Title"]</h1>
</div>

<section class="sheet" style="max-width:820px">
    <form asp-action="@(isNew ? "Create" : "Edit")" method="post" class="sheet-body">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly"></div>
        <div class="form-grid">
            <div class="field span-6">
                <label class="label" asp-for="Name">Full name</label>
                <input asp-for="Name" class="input" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="field span-6">
                <label class="label" asp-for="Email">Email</label>
                <input asp-for="Email" type="email" class="input" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="field span-6">
                <label class="label" asp-for="UserId">Username</label>
                <input asp-for="UserId" class="input" autocapitalize="none" spellcheck="false" />
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>
            <div class="field span-6">
                <label class="label" asp-for="Password">Password</label>
                <input asp-for="Password" type="password" class="input" autocomplete="new-password" placeholder="@(isNew ? "" : "Leave blank to keep the current one")" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="field span-4">
                <label class="label" asp-for="Role">Role</label>
                <select asp-for="Role" asp-items="Html.GetEnumSelectList<Role>()" class="input"></select>
            </div>
            <div class="field span-4">
                <label class="label" asp-for="StudentNumber">Student no.</label>
                <input asp-for="StudentNumber" class="input num" />
                <span asp-validation-for="StudentNumber" class="text-danger"></span>
            </div>
            <div class="field span-4">
                <label class="label" asp-for="YearLevel">Year</label>
                <input asp-for="YearLevel" type="number" min="1" max="6" class="input num" />
                <span asp-validation-for="YearLevel" class="text-danger"></span>
            </div>
            <div class="field">
                <label class="label" asp-for="Course">Course</label>
                <input asp-for="Course" class="input" />
                <span asp-validation-for="Course" class="text-danger"></span>
            </div>
            <div class="field">
                <label class="check"><input asp-for="IsActive" /> Active: this person can sign in</label>
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">@(isNew ? "Create user" : "Save changes")</button>
            <a class="btn btn-outline" asp-action="Index">Cancel</a>
        </div>
    </form>
</section>
