@model List<UserModel>
@{
    ViewData["Title"] = "Users";
    var selectedRole = ViewBag.Role as Role?;
}
<div class="page-header">
    <div>
        <h1>Users</h1>
        <p class="subtitle">Accounts and roles</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="fa-solid fa-user-plus"></i> New User</a>
</div>

<div class="panel">
    <form method="get" class="filter-bar mb-3">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search name, username or student no." />
        <select name="role" class="form-control" style="max-width: 160px" onchange="this.form.submit()">
            <option value="">All roles</option>
            @foreach (Role r in Enum.GetValues(typeof(Role)))
            {
                <option value="@r" selected="@(selectedRole == r)">@r</option>
            }
        </select>
        <button type="submit" class="btn btn-outline-primary"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
    </form>

    @if (!Model.Any())
    {
        <div class="empty-state"><i class="fa-solid fa-users"></i>No users found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-app">
                <thead>
                    <tr><th>Name</th><th>Username</th><th>Student No.</th><th>Course / Year</th><th>Role</th><th>Status</th><th class="text-right">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td>@u.Name<div class="small text-muted">@u.Email</div></td>
                            <td>@u.UserId</td>
                            <td>@u.StudentNumber</td>
                            <td>@u.Course@(u.YearLevel.HasValue ? " – " + u.YearLevel : "")</td>
                            <td>@BadgeHelper.Badge(u.Role)</td>
                            <td>@BadgeHelper.Badge(u.IsActive ? "Active" : "Inactive", u.IsActive ? "open" : "cancelled")</td>
                            <td class="text-right text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@u.Id" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                <form asp-action="ToggleActive" method="post" class="inline-form" data-confirm="@(u.IsActive ? "Deactivate" : "Activate") @u.Name?">
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-primary")" title="@(u.IsActive ? "Deactivate" : "Activate")">
                                        <i class="fa-solid @(u.IsActive ? "fa-user-slash" : "fa-user-check")"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
