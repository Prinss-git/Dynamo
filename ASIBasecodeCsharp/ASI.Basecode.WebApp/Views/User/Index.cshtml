@model List<UserModel>
@{
    ViewData["Title"] = "Users";
    var selectedRole = ViewBag.Role as Role?;
}
<div class="page-head">
    <div>
        <h1 class="page-title">Users</h1>
        <p class="page-sub">Accounts and roles. Officers also need to be members of an organization.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="Create"><i class="fa-solid fa-user-plus" aria-hidden="true"></i> New user</a>
    </div>
</div>

<section class="sheet">
    <div class="sheet-head">
        <form method="get" class="toolbar" role="search">
            <label class="sr-only" for="search">Search users</label>
            <input id="search" type="search" name="search" value="@ViewBag.Search" class="input" placeholder="Name, username or student no." />
            <label class="sr-only" for="role">Role</label>
            <select id="role" name="role" class="input" onchange="this.form.submit()">
                <option value="">All roles</option>
                @foreach (Role r in Enum.GetValues(typeof(Role)))
                {
                    <option value="@r" selected="@(selectedRole == r)">@r</option>
                }
            </select>
            <button type="submit" class="btn btn-outline"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Search</button>
        </form>
    </div>
    @if (!Model.Any())
    {
        @await Html.PartialAsync("_Empty", ("No users found", "Nothing matches that search. Try part of a name or a student number."))
    }
    else
    {
        <div class="ledger-wrap">
            <table class="ledger ledger--stack">
                <thead>
                    <tr><th>Name</th><th>Username</th><th>Student no.</th><th>Course / year</th><th>Role</th><th>Status</th><th class="r"><span class="sr-only">Actions</span></th></tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td><div class="cell-main">@u.Name</div><div class="cell-sub">@u.Email</div></td>
                            <td data-label="Username">@u.UserId</td>
                            <td data-label="Student no."><span class="code">@u.StudentNumber</span></td>
                            <td data-label="Course">@u.Course@(u.YearLevel.HasValue ? " · Year " + u.YearLevel : "")</td>
                            <td data-label="Role">@BadgeHelper.Badge(u.Role)</td>
                            <td data-label="Status">@BadgeHelper.Badge(u.IsActive ? "Active" : "Inactive")</td>
                            <td class="r">
                                <div class="row-actions">
                                    <a class="btn btn-outline btn-sm btn-icon" asp-action="Edit" asp-route-id="@u.Id" title="Edit @u.Name" aria-label="Edit @u.Name"><i class="fa-solid fa-pen" aria-hidden="true"></i></a>
                                    <form asp-action="ToggleActive" method="post" class="inline-form" data-confirm="@(u.IsActive ? "Deactivate" : "Reactivate") @u.Name?">
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline">@(u.IsActive ? "Deactivate" : "Reactivate")</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
