@model PasswordResetRequestModel
@{
    ViewData["Title"] = "Set a temporary password";
}
<a class="back" asp-action="Approvals"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Account approvals</a>
<div class="page-head">
    <div>
        <h1 class="page-title">Set a temporary password</h1>
        <p class="page-sub">Confirm this is the student in front of you (check their school ID), then give them the temporary password in person. They'll choose a new password the next time they sign in.</p>
    </div>
</div>

<section class="sheet" style="max-width:720px">
    <div class="sheet-body">
        <dl class="kv">
            <dt class="label">Name</dt><dd>@Model.Name</dd>
            <dt class="label">Username</dt><dd>@Model.UserId</dd>
            <dt class="label">Student no.</dt><dd><span class="code">@Model.StudentNumber</span></dd>
            <dt class="label">Course / year</dt><dd>@Model.Course@(Model.YearLevel.HasValue ? " · Year " + Model.YearLevel : "")</dd>
            <dt class="label">Requested</dt><dd class="num">@Model.RequestedTime.ToString("MMMM d, yyyy · h:mm tt")</dd>
        </dl>
    </div>
    <form asp-action="ResetPassword" method="post" class="sheet-body" data-live-required>
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly"></div>
        <div class="form-grid">
            <div class="field span-6">
                <label class="label" asp-for="Password">Temporary password</label>
                <input asp-for="Password" type="password" class="input" autocomplete="new-password" data-password-rules />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="field span-6">
                <label class="label" asp-for="ConfirmPassword">Confirm password</label>
                <input asp-for="ConfirmPassword" type="password" class="input" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Set temporary password</button>
            <a class="btn btn-outline" asp-action="Approvals">Cancel</a>
        </div>
    </form>
</section>
