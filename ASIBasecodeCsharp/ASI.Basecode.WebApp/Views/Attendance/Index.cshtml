@model AttendanceSheetModel
@{
    ViewData["Title"] = "Check-in · " + Model.Event.Title;
    var ev = Model.Event;
    var canCheckIn = ev.Status == EventStatus.Open || ev.Status == EventStatus.Closed;
}
<a class="back" asp-controller="Event" asp-action="Details" asp-route-id="@ev.Id"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> @ev.Title</a>
<div class="page-head">
    <div>
        <h1 class="page-title">Check-in desk</h1>
        <p class="page-sub">@ev.OrganizationName · @ev.StartTime.ToString("ddd, MMM d · h:mm tt") · @ev.Venue</p>
    </div>
    <div class="page-actions desk-actions-top">
        <a class="btn btn-outline" asp-controller="Report" asp-action="Event" asp-route-id="@ev.Id"><i class="fa-solid fa-chart-column" aria-hidden="true"></i> Report</a>
        <a class="btn btn-outline" asp-controller="Report" asp-action="ExportEvent" asp-route-id="@ev.Id"><i class="fa-solid fa-file-csv" aria-hidden="true"></i> CSV</a>
    </div>
</div>


<div class="@(canCheckIn ? "desk-grid" : "")">
    @if (canCheckIn)
    {
        <section class="sheet" aria-labelledby="scan-title">
            <div class="sheet-head"><h2 class="sheet-title" id="scan-title">Scan a pass</h2></div>
            <div class="sheet-body scan-body">
                <div id="qr-reader"></div>
                <div>
                <form id="checkin-form" autocomplete="off" style="margin-top:16px">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="eventId" value="@ev.Id" />
                    <label class="label" for="checkin-code" style="display:block;margin-bottom:6px">Or type the code or student no.</label>
                    <div class="scan-entry">
                        <input type="text" name="code" id="checkin-code" class="input" placeholder="e.g. TT4K9QZP2A" required autocapitalize="characters" spellcheck="false" />
                        <button type="submit" class="btn btn-key">Check in</button>
                    </div>
                </form>

                <div id="punch-card" class="punch-card" role="status" aria-live="polite">
                    <div class="pass-band"><div class="pass-org" id="punch-org">@ev.OrganizationName</div></div>
                    <span class="punch-hole" aria-hidden="true"></span>
                    <span class="punch-chad" aria-hidden="true"></span>
                    <div class="punch-body">
                        <div class="punch-name" id="punch-name"></div>
                        <div class="code" id="punch-number"></div>
                        <p class="punch-msg" id="punch-msg"></p>
                    </div>
                </div>
                </div>
            </div>
        </section>
    }

    <div>
        <dl class="fields fields--compact">
        <div><dt class="label">Registered</dt><dd>@Model.Attendees.Count</dd></div>
        <div><dt class="label">Present</dt><dd id="count-present">@Model.PresentCount</dd></div>
        <div><dt class="label">Late</dt><dd id="count-late">@Model.LateCount</dd></div>
        <div><dt class="label">Not yet in</dt><dd id="count-pending">@Model.PendingCount</dd></div>
    </dl>
        <section class="sheet">
            <div class="sheet-head">
                <h2 class="sheet-title">Attendees</h2>
                <label class="sr-only" for="attendee-filter">Filter attendees</label>
                <input type="search" id="attendee-filter" class="input" style="max-width:260px" placeholder="Filter by name or number" />
            </div>
            @if (!canCheckIn)
            {
                <div class="notice" style="margin:16px 20px 0"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><div>Scanning is only available while the event is Open or Closed. You can still correct individual records below.</div></div>
            }
            @if (!Model.Attendees.Any())
            {
                @await Html.PartialAsync("_Empty", ("No one registered yet", "Registered students appear here, ready to be checked in."))
            }
            else
            {
                <div class="ledger-wrap">
                    <table class="ledger ledger--stack" id="attendee-table">
                        <thead>
                            <tr><th>Student</th><th>Code</th><th>Status</th><th>In / out</th><th class="r">Record</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.Attendees)
                            {
                                <tr data-registration-id="@a.Id" data-search="@((a.StudentName + " " + a.StudentNumber + " " + a.RegistrationCode).ToLower())">
                                    <td><div class="cell-main">@a.StudentName</div><div class="cell-sub"><span class="code">@a.StudentNumber</span> · @a.Course</div></td>
                                    <td data-label="Code"><code>@a.RegistrationCode</code></td>
                                    <td data-label="Status" class="cell-status">@BadgeHelper.Badge(a.AttendanceStatus)</td>
                                    <td data-label="In / out" class="cell-time num nowrap">@(a.CheckInTime?.ToString("h:mm tt") ?? "—")@(a.CheckOutTime.HasValue ? " / " + a.CheckOutTime.Value.ToString("h:mm tt") : "")</td>
                                    <td class="r">
                                        <div class="row-actions" style="flex-wrap:wrap">
                                            <form asp-action="SetStatus" method="post" class="row-actions" style="flex-wrap:nowrap">
                                                <input type="hidden" name="id" value="@a.Id" />
                                                <input type="hidden" name="eventId" value="@ev.Id" />
                                                <label class="sr-only" for="status-@a.Id">Status for @a.StudentName</label>
                                                <select name="status" id="status-@a.Id" class="input" style="min-height:36px;width:auto;padding:4px 8px">
                                                    @foreach (AttendanceStatus s in Enum.GetValues(typeof(AttendanceStatus)))
                                                    {
                                                        <option value="@s" selected="@(a.AttendanceStatus == s)">@s</option>
                                                    }
                                                </select>
                                                <label class="sr-only" for="remarks-@a.Id">Remarks for @a.StudentName</label>
                                                <input type="text" name="remarks" id="remarks-@a.Id" value="@a.Remarks" class="input" placeholder="Remarks" style="min-height:36px;width:120px;padding:4px 8px" />
                                                <button type="submit" class="btn btn-outline btn-sm">Save</button>
                                            </form>
                                            @if (canCheckIn && a.CheckInTime.HasValue && !a.CheckOutTime.HasValue)
                                            {
                                                <form asp-action="CheckOut" method="post" class="inline-form">
                                                    <input type="hidden" name="id" value="@a.Id" />
                                                    <input type="hidden" name="eventId" value="@ev.Id" />
                                                    <button type="submit" class="btn btn-outline btn-sm"><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i> Check out</button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        @if (Model.Waitlist.Any())
        {
            <section class="sheet">
                <div class="sheet-head"><h2 class="sheet-title">Waitlist</h2><span class="muted num">@Model.Waitlist.Count waiting</span></div>
                <div class="sheet-body">
                    <ol class="waitlist">
                        @foreach (var w in Model.Waitlist)
                        {
                            <li>@w.StudentName <span class="muted">(<span class="code">@w.StudentNumber</span>) · since @w.RegisteredTime.ToString("MMM d, h:mm tt")</span></li>
                        }
                    </ol>
                </div>
            </section>
        }
    </div>
</div>

<div class="page-actions desk-actions-bottom">
        <a class="btn btn-outline" asp-controller="Report" asp-action="Event" asp-route-id="@ev.Id"><i class="fa-solid fa-chart-column" aria-hidden="true"></i> Report</a>
        <a class="btn btn-outline" asp-controller="Report" asp-action="ExportEvent" asp-route-id="@ev.Id"><i class="fa-solid fa-file-csv" aria-hidden="true"></i> CSV</a>
</div>

@section Scripts {
    @if (canCheckIn)
    {
        <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    }
    <script>
        (function () {
            var filter = document.getElementById("attendee-filter");
            if (filter) {
                filter.addEventListener("input", function () {
                    var term = this.value.trim().toLowerCase();
                    document.querySelectorAll("#attendee-table tbody tr").forEach(function (row) {
                        row.style.display = row.dataset.search.indexOf(term) >= 0 ? "" : "none";
                    });
                });
            }

            var form = document.getElementById("checkin-form");
            if (!form) return;

            var card = document.getElementById("punch-card");
            var codeInput = document.getElementById("checkin-code");
            var busy = false, lastCode = null, lastTime = 0;

            function bump(id, delta) {
                var el = document.getElementById(id);
                if (el) el.textContent = Math.max(parseInt(el.textContent, 10) + delta, 0);
            }

            function showResult(data) {
                document.getElementById("punch-name").textContent = data.studentName || (data.success ? "" : "Not checked in");
                document.getElementById("punch-number").textContent = data.studentNumber || "";
                var msg = data.message || "";
                if (data.status) msg += " " + data.status + (data.time ? " · " + data.time : "");
                document.getElementById("punch-msg").textContent = msg;
                card.className = "punch-card show " + (data.success ? "ok" : "fail");
                void card.offsetWidth; // restart the punch animation
                if (data.success) card.classList.add("animate");
            }

            function updateRow(data) {
                var row = document.querySelector("tr[data-registration-id='" + data.registrationId + "']");
                if (!row) return;
                var css = data.status.toLowerCase();
                var tag = document.createElement("span");
                tag.className = "tag tag-" + css;
                tag.textContent = data.status;
                var cell = row.querySelector(".cell-status");
                cell.innerHTML = "";
                cell.appendChild(tag);
                row.querySelector(".cell-time").textContent = data.time;
                row.querySelector("select[name='status']").value = data.status;
                row.classList.remove("flash"); void row.offsetWidth; row.classList.add("flash");
                bump(css === "late" ? "count-late" : "count-present", 1);
                bump("count-pending", -1);
            }

            function checkIn(code) {
                code = (code || "").trim();
                if (!code || busy) return;
                // The scanner reports the same code many times a second; ignore repeats for 3 seconds.
                var now = Date.now();
                if (code === lastCode && now - lastTime < 3000) return;
                lastCode = code; lastTime = now; busy = true;

                var body = new URLSearchParams(new FormData(form));
                body.set("code", code);
                fetch("@Url.Action("CheckIn")", {
                    method: "POST",
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    body: body
                })
                    .then(function (res) { return res.json(); })
                    .then(function (data) {
                        showResult(data);
                        if (data.success) updateRow(data);
                    })
                    .catch(function () { showResult({ success: false, message: "Couldn't reach the server. Check the connection and scan again." }); })
                    .finally(function () { busy = false; codeInput.value = ""; codeInput.focus(); });
            }

            form.addEventListener("submit", function (e) {
                e.preventDefault();
                lastCode = null; // typed entry always goes through
                checkIn(codeInput.value);
            });

            if (window.Html5QrcodeScanner) {
                var scanner = new Html5QrcodeScanner("qr-reader", { fps: 10, qrbox: { width: 220, height: 220 } }, false);
                scanner.render(function (decodedText) { checkIn(decodedText); }, function () { /* no QR in frame */ });
                var labels = {
                    "html5-qrcode-button-camera-permission": "Start camera",
                    "html5-qrcode-button-camera-start": "Start scanning",
                    "html5-qrcode-button-camera-stop": "Stop scanning"
                };
                var relabel = function () {
                    Object.keys(labels).forEach(function (id) {
                        var b = document.getElementById(id);
                        if (b && b.textContent.trim() !== labels[id]) {
                            b.innerHTML = '<i class="fa-solid fa-camera" aria-hidden="true"></i> ' + labels[id];
                        }
                    });
                };
                relabel();
                new MutationObserver(relabel).observe(document.getElementById("qr-reader"), { childList: true, subtree: true });
            } else {
                document.getElementById("qr-reader").innerHTML = "<p class=\"muted\" style=\"padding:16px;margin:0\">The camera scanner couldn't load. Type the code below instead.</p>";
            }
        })();
    </script>
}
