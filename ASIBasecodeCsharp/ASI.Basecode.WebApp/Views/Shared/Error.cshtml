@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}
<div class="sheet" style="max-width:560px;margin:40px auto">
    <div class="empty">
        <div class="empty-title">Something went wrong</div>
        <p>We couldn't finish that request. Try again, and if it keeps happening, tell an administrator.</p>
        @if (Model?.ShowRequestId == true)
        {
            <p class="muted">Reference: <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-primary" href="@Url.Action("Index", "Home")">Back to dashboard</a>
    </div>
</div>
