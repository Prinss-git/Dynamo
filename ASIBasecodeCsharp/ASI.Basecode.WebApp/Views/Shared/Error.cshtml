@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
    var signedIn = User.Identity?.IsAuthenticated == true;
    Layout = signedIn ? "_Layout" : "_AuthLayout";
}
<div class="sheet" style="max-width:560px;margin:@(signedIn ? "40px auto" : "80px auto 0");width:calc(100% - 32px)">
    <div class="empty">
        <svg width="72" height="56" viewBox="0 0 72 56" aria-hidden="true" focusable="false">
            <rect x="14" y="6" width="44" height="46" rx="6" fill="#ffffff" stroke="#a8231c" stroke-width="2" />
            <rect x="29" y="11" width="14" height="4" rx="2" fill="#a8231c" />
            <path d="M36 22 V36" stroke="#a8231c" stroke-width="3.5" stroke-linecap="round" />
            <circle cx="36" cy="43" r="2.4" fill="#a8231c" />
        </svg>
        <div class="empty-title">Something went wrong</div>
        <p>We couldn't finish that request. Please try again. If it keeps happening, tell an administrator and share the reference below.</p>
        @if (Model?.ShowRequestId == true)
        {
            <p class="muted">Reference: <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-primary" href="@(signedIn ? Url.Action("Index", "Home") : Url.Action("Login", "Account"))">@(signedIn ? "Back to dashboard" : "Back to sign in")</a>
    </div>
</div>
