@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
}
<div class="auth-stage">
    @await Html.PartialAsync("_Lanyard")
    <div class="idcard swing">
        <div class="idcard-band">
            <span class="brand">
                @await Html.PartialAsync("_Mark")
                <span class="brand-name">Student Org Events<small>Registration &amp; attendance</small></span>
            </span>
        </div>
        <div class="idcard-body">
            <h1 class="auth-title">Sign in</h1>
            <p class="auth-sub">Use the username you registered with.</p>
            <form method="post" asp-controller="Account" asp-action="Login" id="loginForm" novalidate>
                <div class="field">
                    <label class="label" asp-for="UserId">Username</label>
                    <input asp-for="UserId" class="input" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus />
                    <span asp-validation-for="UserId" class="text-danger"></span>
                </div>
                <div class="field">
                    <label class="label" asp-for="Password">Password</label>
                    <input asp-for="Password" type="password" class="input" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <button class="btn btn-primary btn-block" type="submit">Sign in</button>
            </form>
        </div>
        <div class="idcard-foot">
            <span>New student?</span>
            <a asp-controller="Account" asp-action="Register">Create an account</a>
        </div>
    </div>
</div>
