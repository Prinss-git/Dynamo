@model ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot password";
}
<div class="auth-stage">
    @await Html.PartialAsync("_Lanyard")
    <div class="idcard">
        <div class="idcard-band">
            <span class="brand">
                @await Html.PartialAsync("_Mark")
                <span class="brand-name">Student Org Events<small>Registration &amp; attendance</small></span>
            </span>
        </div>
        <div class="idcard-body">
            <h1 class="auth-title">Forgot password</h1>
            <p class="auth-sub">Enter your username and student number. An administrator will set a temporary password for you; ask them for it in person, then sign in and choose a new one.</p>
            <form method="post" asp-controller="Account" asp-action="ForgotPassword" data-live-required>
                <div asp-validation-summary="ModelOnly"></div>
                <div class="field">
                    <label class="label" asp-for="UserId">Username</label>
                    <input asp-for="UserId" class="input" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus />
                    <span asp-validation-for="UserId" class="text-danger"></span>
                </div>
                <div class="field">
                    <label class="label" asp-for="StudentNumber">Student number</label>
                    <input asp-for="StudentNumber" class="input num" placeholder="2024-00001" />
                    <span asp-validation-for="StudentNumber" class="text-danger"></span>
                </div>
                <button class="btn btn-primary btn-block" type="submit">Send request</button>
            </form>
        </div>
        <div class="idcard-foot">
            <span>Remembered it?</span>
            <a asp-controller="Account" asp-action="Login">Back to sign in</a>
        </div>
    </div>
</div>
