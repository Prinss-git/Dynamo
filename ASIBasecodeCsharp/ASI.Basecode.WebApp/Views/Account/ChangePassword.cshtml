@model NewPasswordModel
@{
    ViewData["Title"] = "Change password";
    var forced = ViewBag.Forced as bool? ?? false;
}
@if (!forced)
{
    <a class="back" href="@Url.Action("Index", "Home")"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Dashboard</a>
}
<div class="page-head">
    <div>
        <h1 class="page-title">Change password</h1>
        <p class="page-sub">@(forced ? "An administrator set a temporary password for you. Choose your own password to keep using the site." : "Choose a new password for your account.")</p>
    </div>
</div>

<section class="sheet" style="max-width:560px">
    <form asp-action="ChangePassword" method="post" class="sheet-body" data-live-required>
        <div asp-validation-summary="ModelOnly"></div>
        <div class="field">
            <label class="label" asp-for="Password">New password</label>
            <input asp-for="Password" type="password" class="input" autocomplete="new-password" data-password-rules autofocus />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="field">
            <label class="label" asp-for="ConfirmPassword">Confirm new password</label>
            <input asp-for="ConfirmPassword" type="password" class="input" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save new password</button>
            @if (forced)
            {
                <a class="btn btn-outline" asp-action="SignOutUser">Sign out</a>
            }
            else
            {
                <a class="btn btn-outline" href="@Url.Action("Index", "Home")">Cancel</a>
            }
        </div>
    </form>
</section>
