@model EventViewModel
@{
    ViewData["Title"] = Model.Title;
    var statusChanges = ViewBag.StatusChanges as List<EventStatus>;
    var isStudent = User.IsInRole(ASI.Basecode.Resources.Constants.Const.RoleStudent);
    var hasActive = Model.MyRegistrationStatus.HasValue && Model.MyRegistrationStatus != RegistrationStatus.Cancelled;
    var running = Model.Status == EventStatus.Open || Model.Status == EventStatus.Closed;
}
<a class="back no-print" href="@(Model.CanManage && !isStudent ? Url.Action("Manage") : Url.Action("Index"))"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> @(Model.CanManage && !isStudent ? "Manage events" : "All events")</a>

<div class="detail-grid">
    <article class="idcard">
        <div class="idcard-band">
            <div class="pass-org">@Model.OrganizationName</div>
            <h1 class="page-title" style="color:#fff;margin-top:10px">@Model.Title</h1>
            <div style="margin-top:12px">@BadgeHelper.Badge(Model.Status)</div>
        </div>
        <div class="idcard-body">
            <dl class="kv">
                <dt class="label">Starts</dt>
                <dd>@Model.StartTime.ToString("dddd, MMMM d, yyyy · h:mm tt")</dd>
                <dt class="label">Ends</dt>
                <dd>@Model.EndTime.ToString("dddd, MMMM d, yyyy · h:mm tt")</dd>
                <dt class="label">Venue</dt>
                <dd>@Model.Venue</dd>
                <dt class="label">Register by</dt>
                <dd>@Model.RegistrationDeadline.ToString("MMMM d, yyyy · h:mm tt")</dd>
                <dt class="label">Seats</dt>
                <dd class="num">
                    @if (Model.IsUnlimited)
                    {
                        @:Open seating · @Model.RegisteredCount registered
                    }
                    else
                    {
                        @:@Model.RegisteredCount of @Model.Capacity taken · @Model.SlotsLeft left
                    }
                    @if (Model.WaitlistedCount > 0)
                    {
                        <span class="muted"> · @Model.WaitlistedCount on the waitlist</span>
                    }
                </dd>
                @if (Model.CanManage)
                {
                    <dt class="label">Late after</dt>
                    <dd>@Model.LateAfterMinutes min past start</dd>
                }
            </dl>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="id-strip" style="text-align:left">
                    <div class="label" style="margin-bottom:6px">About this event</div>
                    <p class="desc">@Model.Description</p>
                </div>
            }
        </div>
    </article>

    <aside>
        @if (isStudent)
        {
            <section class="sheet">
                <div class="sheet-head"><h2 class="sheet-title">Your pass</h2>@if (hasActive) { @BadgeHelper.Badge(Model.MyRegistrationStatus) }</div>
                <div class="sheet-body">
                    @if (hasActive)
                    {
                        @if (Model.MyRegistrationStatus == RegistrationStatus.Waitlisted)
                        {
                            <p>The event is full. If a seat opens, you move up automatically in the order you joined.</p>
                        }
                        <div class="status-actions">
                            @if (Model.MyRegistrationStatus == RegistrationStatus.Registered)
                            {
                                <a class="btn btn-key btn-block" asp-controller="Registration" asp-action="Ticket" asp-route-id="@Model.MyRegistrationId"><i class="fa-solid fa-qrcode" aria-hidden="true"></i> Show my pass</a>
                            }
                            @if (running && DateTime.Now < Model.StartTime)
                            {
                                <form asp-controller="Registration" asp-action="Cancel" method="post" data-confirm="Give up your spot for this event?">
                                    <input type="hidden" name="id" value="@Model.MyRegistrationId" />
                                    <input type="hidden" name="returnUrl" value="@Url.Action("Details", new { id = Model.Id })" />
                                    <button type="submit" class="btn btn-danger btn-block">Cancel registration</button>
                                </form>
                            }
                        </div>
                    }
                    else if (Model.IsRegistrationOpen)
                    {
                        <p>@(Model.SlotsLeft == 0 ? "Every seat is taken. Join the waitlist and you'll move up if someone cancels." : "Register to get your pass. You'll show its QR code at the door.")</p>
                        <form asp-controller="Registration" asp-action="Register" method="post">
                            <input type="hidden" name="eventId" value="@Model.Id" />
                            <button type="submit" class="btn btn-key btn-block">@(Model.SlotsLeft == 0 ? "Join the waitlist" : "Register for this event")</button>
                        </form>
                    }
                    else
                    {
                        <p class="muted" style="margin:0">Registration is closed for this event.</p>
                    }
                </div>
            </section>
        }

        @if (Model.CanManage)
        {
            <section class="sheet">
                <div class="sheet-head"><h2 class="sheet-title">Run this event</h2></div>
                <div class="sheet-body">
                    <div class="status-actions">
                        @if (running)
                        {
                            <a class="btn btn-key btn-block" asp-controller="Attendance" asp-action="Index" asp-route-eventId="@Model.Id"><i class="fa-solid fa-qrcode" aria-hidden="true"></i> Open the check-in desk</a>
                        }
                        <a class="btn btn-outline btn-block" asp-controller="Report" asp-action="Event" asp-route-id="@Model.Id"><i class="fa-solid fa-chart-column" aria-hidden="true"></i> Attendance report</a>
                        @if (Model.Status != EventStatus.Completed && Model.Status != EventStatus.Cancelled)
                        {
                            <a class="btn btn-outline btn-block" asp-action="Edit" asp-route-id="@Model.Id"><i class="fa-solid fa-pen" aria-hidden="true"></i> Edit details</a>
                        }
                    </div>

                    @if (statusChanges != null && statusChanges.Any())
                    {
                        <div class="label" style="margin:20px 0 8px">Change status</div>
                        <div class="status-actions">
                            @foreach (var status in statusChanges)
                            {
                                var confirm = status switch
                                {
                                    EventStatus.Completed => "Mark this event completed? Registered students who never checked in will be recorded Absent.",
                                    EventStatus.Cancelled => "Cancel this event? Students keep their record but can no longer attend. This can't be undone.",
                                    _ => $"Change the status to {status}?"
                                };
                                var label = status switch
                                {
                                    EventStatus.Open => Model.Status == EventStatus.Draft ? "Publish and open registration" : "Reopen registration",
                                    EventStatus.Closed => "Close registration",
                                    EventStatus.Completed => "Mark completed",
                                    EventStatus.Cancelled => "Cancel event",
                                    _ => status.ToString()
                                };
                                <form asp-action="ChangeStatus" method="post" data-confirm="@confirm">
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <input type="hidden" name="status" value="@status" />
                                    <button type="submit" class="btn btn-block @(status == EventStatus.Cancelled ? "btn-danger" : status == EventStatus.Open && Model.Status == EventStatus.Draft ? "btn-primary" : "btn-outline")">@label</button>
                                </form>
                            }
                        </div>
                    }
                </div>
            </section>
        }
    </aside>
</div>
