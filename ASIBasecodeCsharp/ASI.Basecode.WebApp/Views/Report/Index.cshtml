@model List<EventReportItemModel>
@{
    ViewData["Title"] = "Reports";
    var organizations = ViewBag.Organizations as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var totalRegistered = Model.Sum(m => m.Registered);
    var totalAttended = Model.Sum(m => m.Present + m.Late);
    var totalRate = totalRegistered == 0 ? 0 : Math.Round(totalAttended * 100m / totalRegistered, 1);
}
<div class="page-head">
    <div>
        <h1 class="page-title">Attendance reports</h1>
        <p class="page-sub">Registration and turnout for every published event.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline" asp-action="ExportSummary" asp-route-organizationId="@ViewBag.OrganizationId"><i class="fa-solid fa-file-csv" aria-hidden="true"></i> Export CSV</a>
    </div>
</div>

<dl class="fields">
    <div><dt class="label">Events</dt><dd>@Model.Count</dd></div>
    <div><dt class="label">Registrations</dt><dd>@totalRegistered</dd></div>
    <div><dt class="label">Attended</dt><dd>@totalAttended</dd></div>
    <div><dt class="label">Turnout</dt><dd>@totalRate<small>%</small></dd></div>
</dl>

<section class="sheet">
    <div class="sheet-head">
        <form method="get" class="toolbar">
            <label class="sr-only" for="organizationId">Organization</label>
            <select id="organizationId" name="organizationId" asp-items="organizations" class="input" style="max-width:340px;flex-basis:340px" onchange="this.form.submit()">
                <option value="">All organizations</option>
            </select>
        </form>
    </div>
    @if (!Model.Any())
    {
        @await Html.PartialAsync("_Empty", ("No reports yet", "Reports appear once an event is published and students register."))
    }
    else
    {
        <div class="ledger-wrap">
            <table class="ledger ledger--stack">
                <thead>
                    <tr><th>Event</th><th>Date</th><th>Status</th><th class="r">Registered</th><th class="r">Present</th><th class="r">Late</th><th class="r">Absent</th><th style="min-width:150px">Turnout</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td><div class="cell-main"><a asp-action="Event" asp-route-id="@r.EventId">@r.Title</a></div><div class="cell-sub">@r.OrganizationName</div></td>
                            <td data-label="Date" class="nowrap">@r.StartTime.ToString("MMM d, yyyy")</td>
                            <td data-label="Status">@BadgeHelper.Badge(r.Status)</td>
                            <td data-label="Registered" class="r num">@r.Registered</td>
                            <td data-label="Present" class="r num">@r.Present</td>
                            <td data-label="Late" class="r num">@r.Late</td>
                            <td data-label="Absent" class="r num">@r.Absent</td>
                            <td data-label="Turnout">
                                <div class="num" style="font-weight:600">@r.AttendanceRate%</div>
                                <div class="meter" aria-hidden="true"><span style="width:@r.AttendanceRate.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
