@model AttendanceSheetModel
@{
    ViewData["Title"] = "Report · " + Model.Event.Title;
    var ev = Model.Event;
}
<a class="back no-print" asp-action="Index"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> All reports</a>
<div class="page-head">
    <div>
        <h1 class="page-title">@ev.Title</h1>
        <p class="page-sub">@ev.OrganizationName · @ev.StartTime.ToString("MMMM d, yyyy · h:mm tt") · @ev.Venue</p>
    </div>
    <div class="page-actions no-print">
        <button type="button" class="btn btn-outline" onclick="window.print()"><i class="fa-solid fa-print" aria-hidden="true"></i> Print</button>
        <a class="btn btn-outline" asp-action="ExportEvent" asp-route-id="@ev.Id"><i class="fa-solid fa-file-csv" aria-hidden="true"></i> Export CSV</a>
    </div>
</div>

<dl class="fields">
    <div><dt class="label">Status</dt><dd style="font-size:1rem;padding-top:6px">@BadgeHelper.Badge(ev.Status)</dd></div>
    <div><dt class="label">Registered</dt><dd>@Model.Attendees.Count</dd></div>
    <div><dt class="label">Present</dt><dd>@Model.PresentCount</dd></div>
    <div><dt class="label">Late</dt><dd>@Model.LateCount</dd></div>
    <div><dt class="label">Absent</dt><dd>@Model.AbsentCount</dd></div>
    <div><dt class="label">Turnout</dt><dd>@Model.AttendanceRate<small>%</small></dd></div>
</dl>

<section class="sheet">
    <div class="sheet-head"><h2 class="sheet-title">Attendance record</h2></div>
    @if (!Model.Attendees.Any())
    {
        @await Html.PartialAsync("_Empty", ("No registered attendees", "Nobody registered for this event."))
    }
    else
    {
        <div class="ledger-wrap">
            <table class="ledger ledger--stack">
                <thead>
                    <tr><th class="r">#</th><th>Student</th><th>Course / year</th><th>Registered</th><th>Status</th><th>In</th><th>Out</th><th>Remarks</th></tr>
                </thead>
                <tbody>
                    @{ var i = 1; }
                    @foreach (var a in Model.Attendees)
                    {
                        <tr>
                            <td class="r num muted">@(i++)</td>
                            <td><div class="cell-main">@a.StudentName</div><div class="cell-sub"><span class="code">@a.StudentNumber</span></div></td>
                            <td data-label="Course">@a.Course@(a.YearLevel.HasValue ? " · Year " + a.YearLevel : "")</td>
                            <td data-label="Registered" class="num nowrap">@a.RegisteredTime.ToString("MMM d, h:mm tt")</td>
                            <td data-label="Status">@BadgeHelper.Badge(a.AttendanceStatus)</td>
                            <td data-label="In" class="num nowrap">@(a.CheckInTime?.ToString("h:mm tt") ?? "—")</td>
                            <td data-label="Out" class="num nowrap">@(a.CheckOutTime?.ToString("h:mm tt") ?? "—")</td>
                            <td data-label="Remarks">@a.Remarks</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@if (Model.Waitlist.Any())
{
    <section class="sheet">
        <div class="sheet-head"><h2 class="sheet-title">Waitlist</h2><span class="muted num">@Model.Waitlist.Count waiting</span></div>
        <div class="sheet-body">
            <ol class="waitlist">
                @foreach (var w in Model.Waitlist)
                {
                    <li>@w.StudentName <span class="muted">(<span class="code">@w.StudentNumber</span>)</span></li>
                }
            </ol>
        </div>
    </section>
}
