@model OrganizationViewModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New organization" : "Edit organization";
}
<a class="back" asp-action="Index"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Organizations</a>
<div class="page-head">
    <h1 class="page-title">@ViewData["Title"]</h1>
</div>

<section class="sheet" style="max-width:760px">
    <form asp-action="@(isNew ? "Create" : "Edit")" method="post" class="sheet-body">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly"></div>
        <div class="form-grid">
            <div class="field span-8">
                <label class="label" asp-for="Name">Name</label>
                <input asp-for="Name" class="input" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="field span-4">
                <label class="label" asp-for="Acronym">Acronym</label>
                <input asp-for="Acronym" class="input" />
                <span asp-validation-for="Acronym" class="text-danger"></span>
            </div>
            <div class="field">
                <label class="label" asp-for="Adviser">Adviser</label>
                <input asp-for="Adviser" class="input" />
                <span asp-validation-for="Adviser" class="text-danger"></span>
            </div>
            <div class="field">
                <label class="label" asp-for="Description">Description</label>
                <textarea asp-for="Description" class="input" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="field">
                <label class="check"><input asp-for="IsActive" /> Active: officers can create events for it</label>
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">@(isNew ? "Create organization" : "Save changes")</button>
            <a class="btn btn-outline" asp-action="Index">Cancel</a>
        </div>
    </form>
</section>
