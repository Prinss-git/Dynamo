@model OrganizationMembersModel
@{
    ViewData["Title"] = "Members · " + Model.Organization.Name;
}
<a class="back" asp-action="Index"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Organizations</a>
<div class="page-head">
    <div>
        <h1 class="page-title">@Model.Organization.Name</h1>
        <p class="page-sub">Members with the Officer role can run this organization's events.</p>
    </div>
</div>

<div class="split">
    <section class="sheet">
        <div class="sheet-head"><h2 class="sheet-title">Add a member</h2></div>
        <form asp-action="AddMember" method="post" class="sheet-body">
            <input type="hidden" name="organizationId" value="@Model.Organization.Id" />
            <div class="field">
                <label class="label" for="memberId">Person</label>
                <select name="memberId" id="memberId" class="input" required>
                    <option value="">Select a user</option>
                    @foreach (var u in Model.AvailableUsers)
                    {
                        <option value="@u.Id">@u.Text</option>
                    }
                </select>
            </div>
            <div class="field">
                <label class="label" for="position">Position</label>
                <input type="text" name="position" id="position" class="input" placeholder="e.g. President, Secretary, Member" maxlength="50" />
            </div>
            <button type="submit" class="btn btn-primary btn-block">Add member</button>
        </form>
    </section>

    <section class="sheet">
        <div class="sheet-head"><h2 class="sheet-title">Members</h2><span class="muted num">@Model.Members.Count</span></div>
        @if (!Model.Members.Any())
        {
            @await Html.PartialAsync("_Empty", ("No members yet", "Add the organization's officers first so they can create events."))
        }
        else
        {
            <div class="ledger-wrap">
                <table class="ledger ledger--stack">
                    <thead><tr><th>Name</th><th>Role</th><th>Position</th><th>Joined</th><th class="r"><span class="sr-only">Actions</span></th></tr></thead>
                    <tbody>
                        @foreach (var m in Model.Members)
                        {
                            <tr>
                                <td><div class="cell-main">@m.MemberName</div><div class="cell-sub"><span class="@(m.StudentNumber != null ? "code" : "")">@(m.StudentNumber ?? m.UserId)</span></div></td>
                                <td data-label="Role">@BadgeHelper.Badge(m.Role)</td>
                                <td data-label="Position">
                                    <form asp-action="UpdateMember" method="post" class="row-actions" style="justify-content:flex-start">
                                        <input type="hidden" name="id" value="@m.Id" />
                                        <input type="hidden" name="organizationId" value="@m.OrganizationId" />
                                        <label class="sr-only" for="position-@m.Id">Position of @m.MemberName</label>
                                        <input type="text" name="position" id="position-@m.Id" value="@m.Position" class="input" maxlength="50" style="min-height:36px;width:150px;padding:4px 10px" />
                                        <button type="submit" class="btn btn-outline btn-sm">Save</button>
                                    </form>
                                </td>
                                <td data-label="Joined" class="num nowrap">@m.JoinedTime.ToString("MMM d, yyyy")</td>
                                <td class="r">
                                    <form asp-action="RemoveMember" method="post" class="inline-form" data-confirm="Remove @m.MemberName from this organization?">
                                        <input type="hidden" name="id" value="@m.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
